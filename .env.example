# BHU-TRACE — Environment Variables
# Copy this file to .env and fill in values as needed.
# The app runs fully in mock mode without any of these variables.

# ──────────────────────────────────────────────
# AI / Language Model (optional)
# ──────────────────────────────────────────────
# Uncomment and set to connect Bhu-Assist to a live LLM.
# Keys are read only by the backend API layer — NEVER expose them in frontend code.
# VITE_AI_API_KEY=your_gemini_or_openai_key_here
# VITE_AI_MODEL=gemini-1.5-flash         # or gpt-4o, etc.
# VITE_AI_API_URL=https://your-backend-proxy.example.com/api/chat

# ──────────────────────────────────────────────
# Supabase (optional — for persistent PostgreSQL backend)
# ──────────────────────────────────────────────
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ──────────────────────────────────────────────
# Map Tiles (optional — defaults to OpenStreetMap)
# ──────────────────────────────────────────────
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# ──────────────────────────────────────────────
# App Configuration (optional)
# ──────────────────────────────────────────────
# VITE_APP_VERSION=1.0.0
# VITE_DEMO_MODE=true        # Always true for hackathon prototype

